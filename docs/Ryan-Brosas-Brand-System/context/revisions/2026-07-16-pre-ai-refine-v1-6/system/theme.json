{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Ryan Brosas Brand System",
  "version": "1.5.0",
  "designSystemId": "user:brand-design-system",
  "showcase": {
    "light": "system/kit.html",
    "dark": "system/kit.dark.html"
  },
  "sourcePigments": {
    "paper": "#FEFEFE",
    "charcoal": "#1A1A1A",
    "coral": "#FF5555",
    "signal": "#ECC90F"
  },
  "modes": {
    "light": {
      "canvas": "paper",
      "surfaceSteps": ["paper", "4% charcoal into paper", "8% charcoal into paper"],
      "text": "charcoal"
    },
    "dark": {
      "canvas": "charcoal",
      "surfaceSteps": ["5% paper into charcoal", "9% paper into charcoal", "14% paper into charcoal"],
      "text": "paper"
    }
  },
  "roleFamilies": [
    "surface",
    "text",
    "stroke",
    "action",
    "navigation",
    "panel",
    "field",
    "status",
    "feedback",
    "logo"
  ],
  "typography": {
    "display": "Segoe UI Variable Display",
    "body": "Segoe UI Variable Text",
    "mono": "Cascadia Mono",
    "normalWidthOnly": true
  },
  "layout": {
    "baseline": 8,
    "opticalHalfStep": 4,
    "contentMax": 1480,
    "breakpoints": [600, 820, 1024],
    "minimumTarget": 44
  },
  "assets": {
    "primaryLogo": "logos/Logo---Ryan-1.svg",
    "alternates": [
      "logos/Logo---Ryan-2.svg",
      "logos/Logo---Ryan-3.svg",
      "logos/Logo---Ryan-4.svg"
    ]
  }
}
