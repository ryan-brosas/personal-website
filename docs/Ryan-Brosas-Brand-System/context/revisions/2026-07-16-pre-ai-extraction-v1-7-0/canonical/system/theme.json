{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "Ryan Brosas Brand System",
  "version": "1.6.2",
  "designSystemId": "user:brand-design-system",
  "canonicalTokenSource": "colors_and_type.css",
  "runtimeManifest": "manifest.json",
  "runtimeTokenEntry": "tokens.css",
  "packagedTokenEntry": "system/variables.css",
  "tokenEntryContract": {
    "selfContained": true,
    "allowsImportOnlyWrapper": false,
    "declarationParityWithCanonical": true,
    "runtimeTokenChannel": true
  },
  "showcase": {
    "light": "system/kit.html",
    "dark": "system/kit.dark.html"
  },
  "sourcePigments": {
    "paper": "#FEFEFE",
    "charcoal": "#1A1A1A",
    "coral": "#FF5555",
    "signal": "#ECC90F"
  },
  "modes": {
    "light": {
      "canvas": "paper",
      "surfaceSteps": ["paper", "4% charcoal into paper", "8% charcoal into paper"],
      "text": ["charcoal", "68% charcoal", "52% charcoal"],
      "stroke": ["16% charcoal", "28% charcoal", "42% charcoal"]
    },
    "dark": {
      "canvas": "charcoal",
      "surfaceSteps": ["5% paper into charcoal", "9% paper into charcoal", "14% paper into charcoal"],
      "text": ["paper", "70% paper", "54% paper"],
      "stroke": ["16% paper", "28% paper", "44% paper"]
    }
  },
