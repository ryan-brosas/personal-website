  "typography": {
    "display": "Segoe UI Variable Display",
    "body": "Segoe UI Variable Text",
    "mono": "Cascadia Mono",
    "normalWidthOnly": true,
    "lineHeights": {"displayXL": 0.9, "displayLarge": 0.94, "heading": 1, "body": 1.6, "label": 1.2},
    "bodyMeasure": "45-65ch preferred; 70ch maximum"
  },
  "layout": {
    "baseline": 8,
    "opticalHalfStep": 4,
    "spacing": {"space-1": 4, "space-2": 8, "space-3": 12, "space-4": 16, "space-5": 20, "space-6": 24, "space-8": 32, "space-10": 40, "space-12": 48, "space-16": 64, "space-20": 80, "space-24": 96},
    "contentMax": 1480,
    "breakpoints": [600, 820, 1024],
    "radii": {"editorial": 0, "control": 4, "panel": 8, "statusOnly": 999},
    "minimumTarget": 44
