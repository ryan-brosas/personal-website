  "assets": {
    "viewBox": "0 0 255 211",
    "primaryLogo": "logos/Logo---Ryan-1.svg",
    "alternates": ["logos/Logo---Ryan-2.svg", "logos/Logo---Ryan-3.svg", "logos/Logo---Ryan-4.svg"],
    "centering": "Use grid or flex centering and inspect the visible glyph optically."
  },
  "distribution": {
    "activeComponentFiles": ["Navigation.js", "StatusPanel.js", "SystemMap.js", "ProjectCard.js", "AppShell.js"],
    "allowUnreferencedPrototypeFiles": false
  },
  "acceptance": {
    "tokens": "The packaged token entry is self-contained and declares the same token names as the canonical source.",
    "modes": "Every component keeps anatomy across modes and changes only semantic roles.",
    "voice": "Verified names a source; Proposed names a tradeoff; Open starts with Still needed and names the proof.",
    "showcase": "The registered surface displays all adopted SVGs, explicit foundation roles, light and dark proofs, real states, and the current version."
  }
