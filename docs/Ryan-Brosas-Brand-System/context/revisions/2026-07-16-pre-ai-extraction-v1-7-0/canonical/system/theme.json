  "contrastPairs": [
    {"foreground": "charcoal", "background": "paper", "ratio": 17.26, "textUse": "AAA body and display"},
    {"foreground": "paper", "background": "charcoal", "ratio": 17.26, "textUse": "AAA body and display"},
    {"foreground": "charcoal", "background": "coral", "ratio": 5.54, "textUse": "AA body; primary action"},
    {"foreground": "charcoal", "background": "signal", "ratio": 10.71, "textUse": "AAA; Open state and logo tile"},
    {"foreground": "paper", "background": "coral", "ratio": 3.12, "textUse": "Not ordinary text"}
