---
import type { HTMLTag } from "astro/types";
import HeroOperator from "../assets/brand/operator-mascot.svg";
import HeroSystemMap from "../assets/brand/hero-system-conductor.svg";
import ActionLinks from "./ActionLinks.astro";

export type CommercialPageId = "about" | "services" | "contact";
type HeadingLevel = 1 | 2;

interface ContactActions {
  title: string;
  body: string;
  primaryHref: string;
  primaryLabel: string;
  primaryRel?: string;
  secondaryHref: string;
  secondaryLabel: string;
}

interface Props {
  pageId: CommercialPageId;
  eyebrow: string;
  title: string;
  description: string;
  headingLevel?: HeadingLevel;
  contactActions?: ContactActions;
}

const { pageId, eyebrow, title, description, headingLevel = 1, contactActions } = Astro.props;
if (pageId === "contact" && !contactActions) {
  throw new Error("Contact hero requires settings-driven actions");
}
const Tag = `h${headingLevel}` as HTMLTag;
---
<header class="page-header commercial-hero">
  <div class="page-header__copy">
    <p class="eyebrow">{eyebrow}</p>
    <Tag>{title}</Tag>
    <p class="page-lead">{description}</p>
  </div>

  {
    pageId === "about" && (
      <aside class="page-visual page-visual--about" aria-label="Operator profile">
        <HeroOperator aria-hidden="true" focusable="false" />
      </aside>
    )
  }

  {
    pageId === "services" && (
      <aside class="page-visual page-visual--services" aria-label="System design options">
        <HeroSystemMap aria-hidden="true" focusable="false" />
        <ul class="system-form-list" aria-label="Possible system forms">
          <li>Agent</li>
          <li>Script</li>
          <li>Process</li>
        </ul>
      </aside>
    )
  }

  {
    pageId === "contact" && contactActions && (
      <aside class="page-visual page-visual--contact" aria-label="Start a conversation">
        <div class="contact-action-panel">
          <p class="eyebrow">One task · Two ways to start</p>
          <h2>{contactActions.title}</h2>
          <p class="contact-action-panel__body">{contactActions.body}</p>
          <ActionLinks
            class="contact-action-panel__actions"
            primaryHref={contactActions.primaryHref}
            primaryLabel={contactActions.primaryLabel}
            primaryRel={contactActions.primaryRel}
            secondaryHref={contactActions.secondaryHref}
            secondaryLabel={contactActions.secondaryLabel}
          />
        </div>
      </aside>
    )
  }
</header>
