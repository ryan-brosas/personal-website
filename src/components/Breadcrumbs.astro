---
// W3·T10 — semantic breadcrumb trail. The trail is DERIVED from the ONE route
// registry (ROUTE_REGISTRY.breadcrumbsFor) — never hard-coded — so IA changes
// flow through automatically. The code-owned "home" root is suppressed upstream
// (it owns the brand link), so a top-level page yields a single self-crumb and
// the home shell yields an empty trail (nothing rendered). Works without JS.
import { ROUTE_REGISTRY } from "../config/routes.ts";

interface Props {
  routeId: string;
  // Dynamic-route params (e.g. { slug }) so the leaf crumb's [param] segment
  // resolves. Static routes omit this (breadcrumbsFor tolerates undefined).
  params?: Record<string, string>;
  // Leaf display copy for a collection entry, whose route id is a pattern name
  // ("case-studies-slug") and would otherwise render as "Case Studies Slug".
  leafLabel?: string;
}

const { routeId, params, leafLabel } = Astro.props;
const trail = ROUTE_REGISTRY.breadcrumbsFor(routeId, params, leafLabel);
---
{
  trail.length > 0 && (
    <nav aria-label="Breadcrumb">
      <ol>
        {trail.map((crumb, index) => {
          const isCurrent = index === trail.length - 1;
          return (
            <li>
              {isCurrent ? (
                <span aria-current="page">{crumb.label}</span>
              ) : (
                <a href={crumb.path}>{crumb.label}</a>
              )}
            </li>
          );
        })}
      </ol>
    </nav>
  )
}
