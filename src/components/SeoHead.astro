---
// M2 / W3·T9 — shared SEO head. Accepts EXACTLY one pre-resolved PageMetadata
// object (from src/lib/metadata.ts) — no free-form title/description/canonical
// props. Canonical is derived from ROUTE_REGISTRY inside buildPageMetadata (never
// a prop), so HTML routes keep their trailing slash and file endpoints (e.g.
// /404.html) stay slashless. OG tags are parameterized from metadata.og.
import type { PageMetadata } from "../lib/metadata.ts";

interface Props {
  metadata: PageMetadata;
}

const { metadata } = Astro.props;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg" />
<title>{metadata.title}</title>
<meta name="description" content={metadata.description} />
<link rel="canonical" href={metadata.canonical} />
<meta name="robots" content={metadata.noindex ? "noindex,follow" : "index,follow"} />
<meta property="og:title" content={metadata.og.title} />
<meta property="og:description" content={metadata.og.description} />
<meta property="og:type" content={metadata.og.type} />
<meta property="og:url" content={metadata.canonical} />
<meta property="og:site_name" content={metadata.og.siteName} />
<meta property="og:image" content={metadata.og.image} />
<meta name="twitter:card" content="summary_large_image" />
