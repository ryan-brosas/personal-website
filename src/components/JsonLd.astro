---
// Serializes a pre-built schema.org graph. The owning page supplies Astro.site to
// buildEntityGraph; this component emits inert JSON-LD, not executable client code.
import { serializeJsonLd } from "../lib/structured-data.ts";
import type { JsonLdGraph } from "../lib/structured-data.ts";

interface Props {
  graph: JsonLdGraph;
}

const { graph } = Astro.props;
const serialized = serializeJsonLd(graph);
---
<script is:inline type="application/ld+json" set:html={serialized} />
