---
// Renders public-safe sources for an approved claim (INV-09). Blocked, retired,
// unresolvable, and internal-only-backed claims produce no markup.
import { evidenceSources } from "./authority.ts";
import type { ClaimRecord, SourceRegistry } from "../lib/evidence.ts";

interface Props {
  claim: ClaimRecord;
  registry: SourceRegistry;
}

const { claim, registry } = Astro.props;
const sources = evidenceSources(claim, registry);
---
{
  sources.length > 0 && (
    <aside class="evidence-note">
      <p class="evidence-note__claim">{claim.statement}</p>
      <ul class="evidence-note__sources">
        {sources.map((source) => (
          <li>
            {source.publicUrl ? (
              <a href={source.publicUrl}>{source.title}</a>
            ) : (
              <span>{source.title}</span>
            )}
          </li>
        ))}
      </ul>
    </aside>
  )
}
