---
// M2 (Plan 03, Child 4) — progressively enhanced primary navigation. A root
// brand lockup (decorative R/lightning mark beside the visible site title)
// sits OUTSIDE the Primary nav and owns the root current-page state; the nav
// holds only the visibility-filtered page routes. A disclosure toggle is
// inserted between the brand anchor and the nav.
//
// Progressive enhancement contract: with JavaScript unavailable or the
// enhancement failing to initialize, base CSS keeps all nav links visible and
// the toggle hidden, so navigation works without JavaScript. Only after all
// handlers bind successfully does the script set data-nav-ready, which reveals
// the toggle and (on mobile) collapses the nav until opened. Menu/close icons
// come from the approved utility sprite, injected once via trusted set:html.
import { getEntry, getCollection } from "astro:content";
import { ROOT_ROUTE } from "../lib/routes.ts";
import { resolveRoutes } from "../lib/site-routes.ts";
import { PAGES, NAV_ORDER } from "../config/site.ts";
import type { Visibility } from "../lib/publishing.ts";
import Logo from "../assets/brand/logo-charcoal.svg";
import iconSprite from "../assets/brand/icons.svg?raw";

const settings = await getEntry("settings", "site");
if (!settings) {
  throw new Error('settings entry "site" is missing; cannot render navigation');
}

const pages = await getCollection("pages");
const visibilities: Record<string, Visibility> = {};
for (const page of pages) {
  visibilities[page.id] = page.data.visibility;
}
const resolved = resolveRoutes(visibilities);
const resolvedByPath = new Map(resolved.map((r) => [r.path, r]));

interface NavItem {
  href: string;
  label: string;
}
const navItems: NavItem[] = [];
for (const id of NAV_ORDER) {
  const pageConfig = PAGES.find((p) => p.id === id);
  if (!pageConfig) continue;
  if (!resolvedByPath.has(pageConfig.path)) continue;
  navItems.push({
    href: pageConfig.path,
    label: settings.data.navLabels[pageConfig.navLabelKey],
  });
}

const current = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === ROOT_ROUTE ? current === "/" : current === href;
---
<header class="site-header">
  <a
    class="brand"
    href={ROOT_ROUTE}
    aria-current={isCurrent(ROOT_ROUTE) ? "page" : undefined}
  >
    <Logo aria-hidden="true" focusable="false" />
    <span>{settings.data.siteTitle}</span>
  </a>
  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="primary-navigation"
  >
    <span class="nav-toggle-label">Menu</span>
    <svg aria-hidden="true" focusable="false"><use href="#icon-menu" class="icon-menu"></use></svg>
    <svg aria-hidden="true" focusable="false"><use href="#icon-close" class="icon-close"></use></svg>
  </button>
  <nav id="primary-navigation" aria-label="Primary">
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="icon-sprite" aria-hidden="true" set:html={iconSprite} />
  <script is:inline data-nav-enhancement>
    (function () {
      try {
        var header = document.querySelector(".site-header");
        var button = header && header.querySelector(".nav-toggle");
        var nav = document.getElementById("primary-navigation");
        if (!header || !button || !nav) return;
        var setOpen = function (open) {
          header.setAttribute("data-open", open ? "true" : "false");
          button.setAttribute("aria-expanded", open ? "true" : "false");
        };
        button.addEventListener("click", function () {
          var isOpen = header.getAttribute("data-open") === "true";
          setOpen(!isOpen);
        });
        nav.addEventListener("click", function (e) {
          if (e.target.closest("a")) setOpen(false);
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && header.getAttribute("data-open") === "true") {
            setOpen(false);
            button.focus();
          }
        });
        setOpen(false);
        header.setAttribute("data-nav-ready", "true");
      } catch (e) {
        // Failure leaves the base CSS: links visible, toggle hidden.
      }
    })();
  </script>
</header>
