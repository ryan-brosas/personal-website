---
// M2 (Plan 03, Child 4) — progressively enhanced primary navigation. A root
// brand lockup (decorative R/lightning mark beside the visible site title)
// sits OUTSIDE the Primary nav and owns the root current-page state; the nav
// holds only the visibility-filtered page routes. A disclosure toggle is
// inserted between the brand anchor and the nav.
//
// Progressive enhancement contract: with JavaScript unavailable or the
// enhancement failing to initialize, base CSS keeps all nav links visible and
// the toggle hidden, so navigation works without JavaScript. Only after all
// handlers bind successfully does the script set data-nav-ready, which reveals
// the toggle and (on mobile) collapses the nav until opened. Menu/close icons
// come from the approved utility sprite, injected once via trusted set:html.
import { ROOT_ROUTE } from "../lib/routes.ts";
import { resolveSiteNavigation } from "../lib/navigation.ts";
import Logo from "../assets/brand/logo-charcoal.svg";
import iconSprite from "../assets/brand/icons.svg?raw";

const { siteTitle, primary: navItems } = await resolveSiteNavigation();

// The nav's Home item owns the root current-page state, so the brand lockup stays
// a plain link: two elements marking the same current page would be ambiguous.
const current = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === ROOT_ROUTE ? current === "/" : current === href;
---
<header class="site-header">
  <a class="brand" href={ROOT_ROUTE}>
    <Logo aria-hidden="true" focusable="false" />
    <span class="brand-wordmark">
      <span>{siteTitle}</span>
    </span>
  </a>
  <button
    class="nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="primary-navigation"
  >
    <span class="nav-toggle-label">Menu</span>
    <svg aria-hidden="true" focusable="false"><use href="#icon-menu" class="icon-menu"></use></svg>
    <svg aria-hidden="true" focusable="false"><use href="#icon-close" class="icon-close"></use></svg>
  </button>
  <nav id="primary-navigation" aria-label="Primary">
    <ul>
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={{ "nav-cta": item.emphasis }}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="icon-sprite" aria-hidden="true" set:html={iconSprite} />
  <script is:inline data-nav-enhancement>
    (function () {
      try {
        var header = document.querySelector(".site-header");
        var button = header && header.querySelector(".nav-toggle");
        var nav = document.getElementById("primary-navigation");
        if (!header || !button || !nav) return;
        var setOpen = function (open) {
          header.setAttribute("data-open", open ? "true" : "false");
          button.setAttribute("aria-expanded", open ? "true" : "false");
        };
        button.addEventListener("click", function () {
          var isOpen = header.getAttribute("data-open") === "true";
          setOpen(!isOpen);
        });
        nav.addEventListener("click", function (e) {
          if (e.target.closest("a")) setOpen(false);
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && header.getAttribute("data-open") === "true") {
            setOpen(false);
            button.focus();
          }
        });
        setOpen(false);
        header.setAttribute("data-nav-ready", "true");
      } catch (e) {
        // Failure leaves the base CSS: links visible, toggle hidden.
      }

      try {
        if (!("IntersectionObserver" in window)) return;
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        var selector = [
          ".home-section",
          ".workflow-rail",
          ".case-grid > li",
          ".prose > h2",
          ".prose > h3",
          ".prose > ul",
          ".prose > ol",
          ".evidence-note",
          ".page-cta",
        ].join(",");
        var items = Array.from(document.querySelectorAll(selector));
        if (items.length === 0) return;

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.setAttribute("data-reveal", "visible");
              observer.unobserve(entry.target);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.18 },
        );

        items.forEach(function (item) {
          if (item.getBoundingClientRect().top < window.innerHeight * 0.92) {
            item.setAttribute("data-reveal", "settled");
            return;
          }
          item.setAttribute("data-reveal", "pending");
          observer.observe(item);
        });
        document.documentElement.setAttribute("data-motion-ready", "true");
      } catch (e) {
        document.documentElement.removeAttribute("data-motion-ready");
      }
    })();
  </script>
</header>
