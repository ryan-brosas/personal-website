---
import BrandHeading from "./brand/BrandHeading.astro";
import LoopField from "./LoopField.astro";

interface Props {
  primaryHref: string;
  secondaryHref: string;
}

const { primaryHref, secondaryHref } = Astro.props;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__copy">
    <BrandHeading level={1} role="h1" class="hero__title" id="hero-title">
      Make one repeated task run <span class="brand-highlight">without you.</span>
    </BrandHeading>
    <p class="hero__intro">
      Some work only runs while you watch it. I map one task, build the smallest fix, and test it
      on real work.
    </p>
    <div class="button-row hero__actions">
      <a class="button button--primary" href={primaryHref}>Start with one task</a>
      <a class="button button--secondary" href={secondaryHref}>See a real build</a>
    </div>
  </div>

  <figure class="hero__visual">
    <LoopField />
  </figure>
</section>
