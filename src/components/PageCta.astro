---
import CtaPanel from "./CtaPanel.astro";
import ActionLinks from "./ActionLinks.astro";

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  body: string;
  primaryHref: string;
  primaryLabel: string;
  primaryRel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  body,
  primaryHref,
  primaryLabel,
  primaryRel,
  secondaryHref,
  secondaryLabel,
  class: className,
} = Astro.props;
---
<CtaPanel
  class={`page-cta${className ? ` ${className}` : ""}`}
  id={id}
  eyebrow={eyebrow}
  title={title}
  body={body}
>
  <ActionLinks
    primaryHref={primaryHref}
    primaryLabel={primaryLabel}
    primaryRel={primaryRel}
    secondaryHref={secondaryHref}
    secondaryLabel={secondaryLabel}
  />
</CtaPanel>
