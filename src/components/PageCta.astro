---
interface Props {
  id: string;
  eyebrow: string;
  title: string;
  body: string;
  primaryHref: string;
  primaryLabel: string;
  primaryRel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  id,
  eyebrow,
  title,
  body,
  primaryHref,
  primaryLabel,
  primaryRel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;
---
<section class="page-cta cta-panel" aria-labelledby={id}>
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2 id={id}>{title}</h2>
    <p>{body}</p>
  </div>
  <div class="button-row">
    <a class="button button--primary" href={primaryHref} rel={primaryRel}>{primaryLabel}</a>
    {
      secondaryHref && secondaryLabel && (
        <a class="button button--secondary" href={secondaryHref}>
          {secondaryLabel}
        </a>
      )
    }
  </div>
</section>
