---
import CtaPanel from "./CtaPanel.astro";

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  body: string;
  primaryHref: string;
  primaryLabel: string;
  primaryRel?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  body,
  primaryHref,
  primaryLabel,
  primaryRel,
  secondaryHref,
  secondaryLabel,
  class: className,
} = Astro.props;
---
<CtaPanel
  class={`page-cta${className ? ` ${className}` : ""}`}
  id={id}
  eyebrow={eyebrow}
  title={title}
  body={body}
>
  <div class="button-row">
    <a class="button button--primary" href={primaryHref} rel={primaryRel}>{primaryLabel}</a>
    {
      secondaryHref && secondaryLabel && (
        <a class="button button--secondary" href={secondaryHref}>
          {secondaryLabel}
        </a>
      )
    }
  </div>
</CtaPanel>
