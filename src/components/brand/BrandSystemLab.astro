---
import BrandHeading from "./BrandHeading.astro";
import WorkflowRail from "../WorkflowRail.astro";
import PageCta from "../PageCta.astro";
import ActionLinks from "../ActionLinks.astro";
import PageHeader from "../PageHeader.astro";
import SectionHeading from "../SectionHeading.astro";
import CollectionCard from "../CollectionCard.astro";
import CtaPanel from "../CtaPanel.astro";
import EntryHeader from "../EntryHeader.astro";
import CommercialHero from "../CommercialHero.astro";
import LoopField from "../LoopField.astro";
import ProofStrip from "../ProofStrip.astro";
import SignalList from "../SignalList.astro";
import ProcessDiagram from "../ProcessDiagram.astro";
import EntryPoints from "../EntryPoints.astro";
import CaseFeature from "../CaseFeature.astro";
import CaseStudyDiagram from "../CaseStudyDiagram.astro";
import OutcomeColumns from "../OutcomeColumns.astro";
import VerifiedClaims from "../VerifiedClaims.astro";
import BrandLogo from "../../assets/brand/logo-charcoal.svg";
import OperatorMascot from "../../assets/brand/operator-mascot.svg";
import SystemConductor from "../../assets/brand/hero-system-conductor.svg";
import iconSprite from "../../assets/brand/icons.svg?raw";
import { readFileSync } from "node:fs";

const sourceDirectory = "Ryan-Brosas-Brand-System-Design-System/";
type Section = readonly [id: string, label: string];
type SectionGroup = Readonly<{ label: string; sections: ReadonlyArray<Section> }>;

const sectionGroups: ReadonlyArray<SectionGroup> = [
  { label: "Foundations", sections: [["identity", "Identity"], ["foundations", "Color"], ["contrast", "Contrast"], ["typography", "Typography"], ["layout", "Layout"], ["motion", "Motion"], ["tokens", "Tokens"]] },
  { label: "Components", sections: [["assets", "Assets"], ["actions", "Actions"], ["forms", "Forms"], ["states", "States"]] },
  { label: "Compositions", sections: [["patterns", "Patterns"], ["voice", "Voice"], ["copy", "Copy"]] },
  { label: "Build", sections: [["inventory", "Inventory"], ["gallery", "Gallery"], ["recipes", "Recipes"]] },
  { label: "Operations", sections: [["governance", "Governance"], ["checklist", "Checklist"]] },
];
const sections = sectionGroups.flatMap((group) => group.sections);
const tokenGroups = (() => {
  const globalCss = readFileSync(new URL("../../styles/global.css", import.meta.url), "utf-8");
  const root = globalCss.slice(globalCss.indexOf(":root"), globalCss.indexOf("}", globalCss.indexOf(":root")));
  const tokens = [...root.matchAll(/--([a-z0-9-]+):\s*([^;]+);/g)].map(
    ([, name, value]) => ({ name: `--${name}`, value: value.trim() }),
  );
  const buckets: Record<string, string[]> = {
    Color: ["color-", "canvas$", "surface", "text-", "line", "brand", "signal", "nav-", "link-", "control-", "focus-"],
    Type: ["font-", "type-", "tracking-", "leading-", "weight-", "highlight-"],
    Space: ["space-", "rhythm-", "shell-"],
    Layout: ["content-", "measure-", "prose-", "grid-", "radius-", "target-", "texture-", "canvas-grid"],
    Motion: ["motion-"],
  };
  return Object.entries(buckets).map(([label, prefixes]) => ({
    label,
    tokens: tokens.filter((token) =>
      prefixes.some((prefix) =>
        prefix.endsWith("$")
          ? token.name === `--${prefix.slice(0, -1)}`
          : token.name.startsWith(`--${prefix}`),
      ),
    ),
  }));
})();
const iconNames = [...iconSprite.matchAll(/<symbol id="(icon-[a-z-]+)"/g)].map((match) => match[1]);
const sectionNumber = (id: string) => String(sections.findIndex(([sectionId]) => sectionId === id) + 1).padStart(2, "0");
---
<section class="brand-lab" data-brand-lab aria-labelledby="brand-lab-title">
  <header class="brand-lab__header">
    <div>
      <p class="eyebrow">Local design system</p>
      <BrandHeading level={1} role="h2" class="brand-lab__title" id="brand-lab-title">Brand Lab</BrandHeading>
      <p class="brand-lab__lede">
        The working reference for Ryan Brosas identity, foundations, components, states, patterns,
        and voice. Change a shared token or component here, then verify it on the website.
      </p>
    </div>
    <p class="brand-lab__status">Development only / never published</p>
  </header>

  <div class="brand-lab__architecture" aria-label="Design system organization">
    <article><span>01</span><strong>Foundations</strong><p>Identity, color, contrast, type, spacing, and grid establish constraints.</p></article>
    <article><span>02</span><strong>Components</strong><p>Assets and controls consume foundation tokens rather than raw values.</p></article>
    <article><span>03</span><strong>Compositions</strong><p>Patterns combine components into recognizable page and content structures.</p></article>
    <article><span>04</span><strong>Build</strong><p>Inventory and recipes name the exact modules and steps a new page uses.</p></article>
    <article><span>05</span><strong>Operations</strong><p>Governance verifies changes against accessibility and production behavior.</p></article>
  </div>

  <nav class="brand-lab__nav" aria-label="Brand Lab sections">
    <div class="brand-lab__nav-track">
      {sectionGroups.map((group) => (
        <div class="brand-lab__nav-group">
          <strong>{group.label}</strong>
          <ol>
            {group.sections.map(([id, label]) => (
              <li><a href={`#brand-${id}`}><span>{sectionNumber(id)}</span>{label}</a></li>
            ))}
          </ol>
        </div>
      ))}
    </div>
  </nav>

  <div class="brand-lab__workspace">
    <section class="brand-lab__section brand-lab__identity" id="brand-identity" aria-labelledby="brand-identity-title">
      <div class="brand-lab__section-heading">
        <p class="brand-lab__index">01 / Identity</p>
        <div>
          <BrandHeading level={2} role="h2" id="brand-identity-title">Ryan Brosas</BrandHeading>
          <p>Agent Systems Builder</p>
        </div>
      </div>
      <div class="brand-lab__identity-grid">
        <div class="brand-lab__logo-lockup">
          <BrandLogo aria-label="Ryan Brosas adopted charcoal symbol" />
          <div><strong>Ryan Brosas</strong><span>Agent Systems Builder</span></div>
        </div>
        <blockquote>
          <p>I build agent systems so repetitive work stops coming back to you.</p>
          <cite>Primary positioning statement</cite>
        </blockquote>
        <dl class="brand-lab__principles">
          <div><dt>01</dt><dd>Systems before spectacle.</dd></div>
          <div><dt>02</dt><dd>Useful before impressive.</dd></div>
          <div><dt>03</dt><dd>Honest about failure.</dd></div>
          <div><dt>04</dt><dd>Share the process.</dd></div>
        </dl>
      </div>
    </section>

    <section class="brand-lab__section" id="brand-foundations" aria-labelledby="brand-foundations-title">
      <div class="brand-lab__section-heading">
        <p class="brand-lab__index">02 / Foundations</p>
        <div><BrandHeading level={2} role="h3" id="brand-foundations-title">Color, rhythm, and geometry</BrandHeading><p>Semantic roles before decorative choices.</p></div>
      </div>
      <div class="brand-lab__fields" aria-label="Canonical color fields">
        <div class="brand-lab__field brand-lab__field--paper"><strong>Warm paper</strong><span>#FDF9E5 · foundation</span></div>
        <div class="brand-lab__field brand-lab__field--charcoal"><strong>Charcoal</strong><span>#1A1A1A · structure / text</span></div>
        <div class="brand-lab__field brand-lab__field--coral"><strong>Coral</strong><span>#FF5555 · action / emphasis</span></div>
        <div class="brand-lab__field brand-lab__field--yellow"><strong>Signal yellow</strong><span>#ECC90F · scarce signal</span></div>
      </div>
      <div class="brand-lab__foundation-notes">
        <article><strong>8px</strong><span>Baseline spacing rhythm</span></article>
        <article><strong>1px</strong><span>Structural border weight</span></article>
        <article><strong>0 / 2 / 4 / 8</strong><span>Plate, control, panel radius</span></article>
        <article><strong>44px</strong><span>Minimum important target</span></article>
      </div>
      <div class="brand-lab__token-flow" aria-label="Color token architecture">
        <article><span>01 / Source</span><strong>Four pigments</strong><p>Warm paper, charcoal, coral, and signal yellow are the entire raw palette.</p></article>
        <article><span>02 / Semantic</span><strong>Purpose before hue</strong><p>Canvas, surface, text, line, action, signal, and state roles describe intent.</p></article>
        <article><span>03 / Component</span><strong>Consume roles</strong><p>Buttons, fields, navigation, and panels never choose raw pigments directly.</p></article>
        <article><span>04 / State</span><strong>Shape plus color</strong><p>Focus, current, invalid, disabled, and verified remain distinguishable without hue alone.</p></article>
      </div>
      <ul class="brand-lab__sources" aria-label="Color foundation sources">
        <li><a href="https://designsystem.digital.gov/design-tokens/color/overview/">USWDS Using Color</a></li>
      </ul>
    </section>

    <section class="brand-lab__section" id="brand-contrast" aria-labelledby="brand-contrast-title">
      <div class="brand-lab__section-heading">
        <p class="brand-lab__index">03 / Contrast</p>
        <div><BrandHeading level={2} role="h3" id="brand-contrast-title">Make the palette do a job</BrandHeading><p>WCAG ratios define which combinations can carry text and which should create emphasis through fields, borders, and shape.</p></div>
      </div>
      <div class="brand-lab__contrast-grid" aria-label="Brand color contrast checks">
        <article class="brand-lab__contrast brand-lab__contrast--paper">
          <div><span>Charcoal on warm paper</span><strong data-contrast-ratio="15.53">15.53:1</strong></div>
          <p><b>AAA pass.</b> Paper and charcoal carry most reading and structural work, leaving the accents free to mark hierarchy.</p>
        </article>
        <article class="brand-lab__contrast brand-lab__contrast--dark">
          <div><span>Warm inverse on charcoal</span><strong data-contrast-ratio="15.53">15.53:1</strong></div>
          <p><b>AAA pass.</b> Charcoal frames evidence, technical systems, and high-authority sections without losing readability.</p>
        </article>
        <article class="brand-lab__contrast brand-lab__contrast--coral">
          <div><span>Charcoal on coral</span><strong data-contrast-ratio="5.54">5.54:1</strong></div>
          <p><b>AA pass.</b> Coral owns primary actions, selected surfaces, and one decisive expressive field.</p>
        </article>
        <article class="brand-lab__contrast brand-lab__contrast--signal">
          <div><span>Charcoal on signal yellow</span><strong data-contrast-ratio="10.71">10.71:1</strong></div>
          <p><b>AAA pass.</b> Yellow stays scarce so one annotation, warning, or focal field remains unmistakable.</p>
        </article>
      </div>
      <div class="brand-lab__contrast-cautions">
        <article><span>Do not reverse coral</span><strong>Warm inverse on coral · 2.80:1</strong><p>It fails normal and large text. Put charcoal on coral instead.</p></article>
        <article><span>No muted copy on action</span><strong>Muted text on coral · 3.20:1</strong><p>Coral descendants inherit charcoal; secondary gray breaks the action surface contract.</p></article>
        <article><span>Decoration, not body copy</span><strong>Coral on warm paper · 2.97:1</strong><p>Use coral for underlines, rules, icons, and large fields while linked text stays charcoal.</p></article>
      </div>
      <aside class="brand-lab__color-advantage" aria-labelledby="color-advantage-title">
        <div><p class="eyebrow">Brand advantage</p><h3 id="color-advantage-title">Recognition comes from role consistency.</h3></div>
        <ul>
          <li><strong>Paper</strong><span>keeps the default reading experience calm and warm.</span></li>
          <li><strong>Charcoal</strong><span>carries structure, evidence panels, and nearly all text.</span></li>
          <li><strong>Coral</strong><span>owns action, selection, and expressive emphasis.</span></li>
          <li><strong>Yellow</strong><span>stays scarce so a real signal still feels important.</span></li>
        </ul>
      </aside>
      <ul class="brand-lab__sources" aria-label="Contrast foundation sources">
        <li><a href="https://www.w3.org/WAI/WCAG22/Understanding/contrast-minimum.html">W3C Contrast Minimum</a></li>
        <li><a href="https://www.w3.org/WAI/WCAG22/Understanding/non-text-contrast.html">W3C Non-text Contrast</a></li>
      </ul>
    </section>

    <section class="brand-lab__section" id="brand-typography" aria-labelledby="brand-typography-title">
      <div class="brand-lab__section-heading">
        <p class="brand-lab__index">04 / Typography</p>
        <div><BrandHeading level={2} role="h3" id="brand-typography-title">Technical editorial hierarchy</BrandHeading><p>Segoe UI Variable / Inter fallback, with mono reserved for operating detail.</p></div>
      </div>
      <div class="brand-lab__type-sheet">
        <BrandHeading level={3} role="h1">H1 / Build the loop.</BrandHeading>
        <BrandHeading level={3} role="h2">H2 / Keep <span class="brand-highlight">control visible.</span></BrandHeading>
        <BrandHeading level={4} role="h3">H3 / Find the loop. Build the system.</BrandHeading>
        <BrandHeading level={5} role="h4">H4 / Make judgment explicit</BrandHeading>
        <BrandHeading level={6} role="h5">H5 / Evidence before handoff</BrandHeading>
        <p class="brand-heading brand-heading--h6">H6 / System conductor · verified · recovery ready</p>
        <p class="brand-lab__body-copy">A working system keeps context attached, checks output before handoff, and gives failure a route. Body copy stays readable, direct, and bounded to roughly 45–65 characters per line.</p>
        <p class="brand-lab__mono">MONO / Labels · metadata · specifications · technical evidence</p>
      </div>
      <div class="brand-lab__reading-rules" aria-label="Web typography fundamentals">
        <article><strong>16px+</strong><span>Running-text floor</span><p>Body copy starts at a comfortable browser reading size; smaller text is reserved for short labels and metadata.</p></article>
        <article><strong>66ch</strong><span>Reading measure</span><p>Long-form prose targets about 66 characters. Leads and large headings use the narrower 45-character role.</p></article>
        <article><strong>1.5–1.65</strong><span>Running line height</span><p>Paragraphs use unitless leading so spacing scales with text zoom. One- or two-line headings stay tighter.</p></article>
        <article><strong>3 tiers</strong><span>Visible hierarchy</span><p>A screen should emphasize a primary, supporting, and reading level—not make every semantic heading compete.</p></article>
      </div>
      <aside class="brand-lab__spacing-proof">
        <strong>Text-spacing resilience</strong>
        <p>Content must remain readable when users override line height to 1.5, paragraph spacing to 2em, letter spacing to .12em, and word spacing to .16em.</p>
      </aside>
      <ul class="brand-lab__sources" aria-label="Typography research sources">
        <li><a href="https://www.w3.org/WAI/WCAG22/Understanding/text-spacing.html">W3C Text Spacing</a></li>
        <li><a href="https://designsystem.digital.gov/components/typography/">U.S. Web Design System Typography</a></li>
        <li><a href="https://developer.mozilla.org/en-US/docs/Web/CSS/Reference/Properties/line-height">MDN line-height</a></li>
        <li><a href="https://www.nngroup.com/articles/visual-hierarchy-ux-definition/">NN/g Visual Hierarchy</a></li>
      </ul>
    </section>

    <section class="brand-lab__section" id="brand-layout" aria-labelledby="brand-layout-title">
      <div class="brand-lab__section-heading">
        <p class="brand-lab__index">05 / Layout</p>
        <div><BrandHeading level={2} role="h3" id="brand-layout-title">Spacing, grid, and alignment</BrandHeading><p>An 8px mini-unit controls fixed space; responsive columns create shared key lines without forcing content into equal boxes.</p></div>
      </div>
      <div class="brand-lab__layout-grid" aria-label="Responsive column grid demonstration">
        {Array.from({ length: 16 }, (_, index) => <span>{String(index + 1).padStart(2, "0")}</span>)}
      </div>
      <div class="brand-lab__breakpoints">
        <article><strong>4 columns</strong><span>Compact · up to 600px</span><p>Single reading flow. Controls stack and retain 44px targets.</p></article>
        <article><strong>8 columns</strong><span>Medium · 601–820px</span><p>Related content may pair; primary reading order remains explicit.</p></article>
        <article><strong>16 columns</strong><span>Wide · above 820px</span><p>Editorial compositions align to shared vertical key lines.</p></article>
      </div>
      <div class="brand-lab__spacing-scale" aria-label="Fluid spacing scale on an 8 pixel rhythm">
        <span><i class="space-1"></i><b>8px</b></span><span><i class="space-2"></i><b>12–16px</b></span><span><i class="space-3"></i><b>16–24px</b></span><span><i class="space-4"></i><b>20–32px</b></span><span><i class="space-6"></i><b>28–48px</b></span><span><i class="space-8"></i><b>36–64px</b></span>
      </div>
      <div class="brand-lab__layout-rules">
        <article><strong>Align type to padding</strong><p>Text starts on a key line, never floats ambiguously inside a region.</p></article>
        <article><strong>Proximity shows ownership</strong><p>Related items sit closer together than unrelated groups.</p></article>
        <article><strong>Containers are evidence</strong><p>Use borders and fields only when whitespace cannot explain the grouping.</p></article>
        <article><strong>Content chooses the breakpoint</strong><p>Layouts change when reading order or target integrity would otherwise fail.</p></article>
      </div>
      <ul class="brand-lab__sources" aria-label="Layout foundation sources">
        <li><a href="https://carbondesignsystem.com/elements/2x-grid/overview/">Carbon 2x Grid</a></li>
        <li><a href="https://www.nngroup.com/articles/gestalt-proximity/">NN/g Proximity Principle</a></li>
      </ul>
    </section>

    <section class="brand-lab__section" id="brand-motion" aria-labelledby="brand-motion-title">
      <div class="brand-lab__section-heading">
        <p class="brand-lab__index">06 / Motion</p>
        <div><BrandHeading level={2} role="h3" id="brand-motion-title">Movement confirms, never performs</BrandHeading><p>Transitions exist to confirm a state change. Nothing animates on load, and every duration collapses under a reduced-motion preference.</p></div>
      </div>
      <div class="brand-lab__motion">
        <article><strong>160ms</strong><span>Standard duration</span><p><code>--motion-fast</code> covers hover, focus, and selection feedback. Longer feels sluggish under repeated use.</p></article>
        <article><strong>ease</strong><span>Standard curve</span><p><code>--motion-ease</code> keeps movement predictable. No bounce, overshoot, or decorative spring.</p></article>
        <article><strong>Color and border</strong><span>Animated properties</span><p>Only cheap, non-layout properties transition. Never animate width, height, or position on scroll.</p></article>
        <article><strong>0.01ms</strong><span>Reduced motion</span><p><code>prefers-reduced-motion: reduce</code> collapses every transition and disables smooth scrolling.</p></article>
      </div>
      <aside class="brand-lab__motion-demo">
        <div><strong>Try it</strong><p>Hover or tab to these controls. State is legible from shape and contrast alone—motion only softens the change.</p></div>
        <ActionLinks
          primaryHref="#brand-motion"
          primaryLabel="Inspect the workflow"
          secondaryHref="#brand-motion"
          secondaryLabel="Read the evidence"
        />
      </aside>
    </section>

    <section class="brand-lab__section" id="brand-tokens" aria-labelledby="brand-tokens-title">
      <div class="brand-lab__section-heading">
        <p class="brand-lab__index">07 / Tokens</p>
        <div><BrandHeading level={2} role="h3" id="brand-tokens-title">Every name you can type</BrandHeading><p>Read straight from <code>src/styles/global.css</code> at build time, so this list cannot drift from the running site.</p></div>
      </div>
      <div class="brand-lab__tokens">
        {tokenGroups.map((group) => (
          <article>
            <h3>{group.label}</h3>
            <dl>
              {group.tokens.map((token) => (
                <div><dt>{token.name}</dt><dd>{token.value}</dd></div>
              ))}
            </dl>
          </article>
        ))}
      </div>
    </section>

    <section class="brand-lab__section" id="brand-assets" aria-labelledby="brand-assets-title">
      <div class="brand-lab__section-heading">
        <p class="brand-lab__index">08 / Assets</p>
        <div><BrandHeading level={2} role="h3" id="brand-assets-title">Marks and narrative imagery</BrandHeading><p>Use approved geometry and owned evidence—never generic AI imagery.</p></div>
      </div>
      <div class="brand-lab__asset-grid">
        <figure class="brand-lab__asset brand-lab__asset--logo"><BrandLogo aria-label="Adopted Ryan Brosas charcoal logo" /><figcaption>Adopted mark / preserve ratio / choose variant by contrast</figcaption></figure>
        <figure class="brand-lab__asset brand-lab__asset--operator"><OperatorMascot /><figcaption>The Operator / supporting identity character</figcaption></figure>
        <figure class="brand-lab__asset brand-lab__asset--system"><SystemConductor aria-label="System conductor workflow illustration" /><figcaption>System conductor / context, checks, handoff, recovery</figcaption></figure>
      </div>
      <div class="brand-lab__icons" aria-label="Shared icon set">
        {iconNames.map((name) => (
          <figure><svg aria-hidden="true" focusable="false"><use href={`#${name}`} /></svg><figcaption>{name}</figcaption></figure>
        ))}
      </div>
      <p class="brand-lab__asset-rule"><strong>Icons:</strong> one approved sprite, referenced with <code>&lt;use href="#icon-name"&gt;</code>. Icons inherit <code>currentColor</code> and never carry meaning alone—always pair one with text or an accessible name.</p>
      <p class="brand-lab__asset-rule"><strong>Prefer:</strong> product screenshots, terminal captures, workflow diagrams, context maps, checks, failure states, and recovery paths.</p>
    </section>

    <section class="brand-lab__section" id="brand-actions" aria-labelledby="brand-actions-title">
      <div class="brand-lab__section-heading">
        <p class="brand-lab__index">09 / Actions</p>
        <div><BrandHeading level={2} role="h3" id="brand-actions-title">Controls and navigation</BrandHeading><p>Concrete verb plus object. Persistent selection is not evidence status.</p></div>
      </div>
      <div class="brand-lab__demo-grid">
        <article class="brand-lab__demo">
          <h3>Buttons</h3>
          <div class="button-row">
            <a class="button button--primary" href="#brand-actions">Inspect the workflow</a>
            <a class="button button--secondary" href="#brand-actions">Read the evidence</a>
            <button class="button" type="button" disabled>Checking output</button>
          </div>
          <p>Hover and keyboard focus use visible shape and contrast changes. Disabled remains legible.</p>
        </article>
        <article class="brand-lab__demo">
          <h3>Compact navigation</h3>
          <nav class="brand-lab__nav-demo" aria-label="Navigation component example">
            <a href="#brand-identity">Ryan Brosas</a>
            <a href="#brand-actions" aria-current="page">Design system</a>
            <a class="brand-lab__nav-cta" href="#brand-governance">Review changes</a>
          </nav>
          <p>Current location is written with <code>aria-current</code>; targets remain at least 44px tall.</p>
        </article>
      </div>
    </section>

    <section class="brand-lab__section" id="brand-forms" aria-labelledby="brand-forms-title">
      <div class="brand-lab__section-heading">
        <p class="brand-lab__index">10 / Forms</p>
        <div><BrandHeading level={2} role="h3" id="brand-forms-title">Fields and feedback</BrandHeading><p>Labels, hints, validation, and recovery stay connected in words.</p></div>
      </div>
      <fieldset class="brand-lab__fieldset">
        <legend>Workflow intake field states</legend>
        <label><span>Workflow to inspect</span><small id="workflow-hint">Name the recurring work, not the hoped-for technology.</small><input type="text" value="Weekly project evidence review" aria-describedby="workflow-hint" /></label>
        <label><span>Owned proof</span><small id="proof-error">Error: the file was not attached. Your draft is safe. Attach a source or mark the claim Open.</small><input type="text" value="No source attached" aria-invalid="true" aria-describedby="proof-error" /></label>
        <label><span>System owner</span><small>Read-only values can still be selected and copied.</small><input type="text" value="Ryan Brosas" readonly /></label>
        <label><span>Archived destination</span><small>Disabled because this route is not part of the current workflow.</small><input type="text" value="Legacy queue" disabled /></label>
      </fieldset>
    </section>

    <section class="brand-lab__section" id="brand-states" aria-labelledby="brand-states-title">
      <div class="brand-lab__section-heading">
        <p class="brand-lab__index">11 / States</p>
        <div><BrandHeading level={2} role="h3" id="brand-states-title">Evidence and lifecycle vocabulary</BrandHeading><p>Confidence, operation, and interaction are separate layers.</p></div>
      </div>
      <div class="brand-lab__status-grid">
        <article class="brand-lab__status-card brand-lab__status-card--verified"><span>Verified</span><h3>Route policy is centralized.</h3><p><code>src/config/routes.ts</code> is the inspected source for paths and navigation.</p></article>
        <article class="brand-lab__status-card brand-lab__status-card--proposed"><span>Proposed</span><h3>Add a reusable field component.</h3><p>It would reduce drift, but adds an API that must cover labels, hints, and invalid states.</p></article>
        <article class="brand-lab__status-card brand-lab__status-card--open"><span>Open</span><h3>Still needed: owned project media.</h3><p>Add an inspected workflow capture before publishing a visual outcome claim.</p></article>
      </div>
      <div class="brand-lab__lifecycle" aria-label="Operational lifecycle">
        <span>Default</span><span>Loading / validating</span><span>Content / empty</span><span>Error</span><span>Recovery</span>
      </div>
    </section>

    <section class="brand-lab__section" id="brand-patterns" aria-labelledby="brand-patterns-title">
