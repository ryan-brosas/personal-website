---
// Commercial pages reuse BaseLayout and add registry-derived breadcrumbs plus a
// JSON-LD graph keyed to Astro.site. `kind` defaults to service; about and contact
// pass webpage so structured data matches visible content. buildEntityGraph omits
// page-level nodes for non-public content (INV-03).
import BaseLayout from "./BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildEntityGraph } from "../lib/structured-data.ts";
import type { Visibility } from "../lib/publishing.ts";

interface Props {
  routeId: string;
  title: string;
  description: string;
  visibility: Visibility;
  noindex?: boolean;
  kind?: "webpage" | "service";
}

const { routeId, title, description, visibility, noindex, kind = "service" } = Astro.props;

// Astro.site is the real origin from astro.config (SITE_ORIGIN ?? placeholder);
// buildEntityGraph normalises the trailing slash. Fall back to the placeholder
// so a mis-set config never throws at render time.
const site = Astro.site?.href ?? "https://example.com";
const graph = buildEntityGraph({
  site,
  page: { routeId, title, description, visibility, kind },
});
---
<BaseLayout routeId={routeId} title={title} description={description} noindex={noindex}>
  <JsonLd graph={graph} />
  <Breadcrumbs routeId={routeId} />
  <slot />
</BaseLayout>
