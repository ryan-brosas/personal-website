---
// M2 (Plan 03, Child 4) — shared document shell. Standards-mode HTML, head via
// SeoHead, skip link, SiteHeader, one <main id="main"><slot /></main>. Brand
// tokens flow from the canonical tokens.css through global.css; the :focus-visible
// rule comes from tokens.css. No motion, no client script.
// W3·T9: the shell no longer takes free-form canonical/title strings. It takes a
// registry `routeId` and calls buildPageMetadata, so canonical + robots policy
// derive from the ONE route registry. title/description/noindex are optional
// overrides (page copy lives outside the registry; noindex overrides the
// registry visibility for the 404 endpoint and content-driven noindex pages).
import SeoHead from "../components/SeoHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { buildPageMetadata } from "../lib/metadata.ts";
import "../styles/global.css";

interface Props {
  routeId: string;
  title?: string;
  description?: string;
  noindex?: boolean;
  // Dynamic-route params (e.g. { slug }) so the canonical resolves for a
  // collection entry. Static routes omit this.
  params?: Record<string, string>;
}

const { routeId, title, description, noindex, params } = Astro.props;
const metadata = buildPageMetadata(routeId, { title, description, noindex, params });
---
<!doctype html>
<html lang="en">
  <head>
    <SeoHead metadata={metadata} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
