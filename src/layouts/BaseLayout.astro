---
// M2 (Plan 03, Child 4) — shared document shell. Standards-mode HTML, head via
// SeoHead, skip link, SiteHeader, one <main id="main"><slot /></main>. Brand
// tokens flow from the canonical tokens.css through global.css; the :focus-visible
// rule comes from tokens.css. No motion, no client script.
import SeoHead from "../components/SeoHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const { title, description, canonicalPath, noindex } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
