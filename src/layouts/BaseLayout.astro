---
// Shared document shell with metadata, skip navigation, one main landmark, site
// navigation, footer, and optional motion. buildPageMetadata derives canonical and
// robots policy from routeId; page copy and controlled noindex cases may override
// their corresponding metadata fields.
import SeoHead from "../components/SeoHead.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { buildPageMetadata } from "../lib/metadata.ts";
import "../styles/global.css";

interface Props {
  routeId: string;
  title?: string;
  description?: string;
  noindex?: boolean;
  // Dynamic-route params (e.g. { slug }) so the canonical resolves for a
  // collection entry. Static routes omit this.
  params?: Record<string, string>;
  // Editorial records ("article") vs ordinary pages. Mirrors the JSON-LD kind so
  // the card and the entity graph describe the page the same way.
  ogType?: "website" | "article";
}

const { routeId, title, description, noindex, params, ogType } = Astro.props;
const metadata = buildPageMetadata(routeId, { title, description, noindex, params, ogType });
---
<!doctype html>
<html lang="en">
  <head>
    <SeoHead metadata={metadata} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
