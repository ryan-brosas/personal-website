---
// M2 (Plan 03, Child 2) — shared document shell. Standards-mode HTML, head via
// SeoHead, skip link, SiteHeader, one <main id="main"><slot /></main>. Structural
// CSS only (no brand tokens, no motion, no client script). The :focus-visible
// rule uses :global so it applies to links inside SiteHeader and slotted page
// content.
import SeoHead from "../components/SeoHead.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const { title, description, canonicalPath, noindex } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main">
      <slot />
    </main>
    <style is:global>
      /* Structural shell CSS — no brand tokens, no motion. */
      * {
        box-sizing: border-box;
      }
      html {
        -webkit-text-size-adjust: 100%;
      }
      body {
        margin: 0;
        font-family: system-ui, sans-serif;
        line-height: 1.5;
      }
      /* Skip link: visually hidden until focused, then visible. */
      .skip-link {
        position: absolute;
        inset-block-start: 0;
        inset-inline-start: 0;
        transform: translateY(-120%);
        z-index: 1;
      }
      .skip-link:focus-visible {
        transform: translateY(0);
      }
      /* Visible focus for all interactive elements, across component boundaries. */
      :focus-visible {
        outline: 2px solid currentColor;
        outline-offset: 3px;
      }
      /* Responsive navigation: one always-visible tree that reflows. */
      header nav ul {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin: 0;
        padding: 0.75rem 1rem;
      }
      header nav a {
        text-decoration: underline;
      }
      main {
        padding: 1rem;
        max-width: 64rem;
        margin-inline: auto;
      }
    </style>
  </body>
</html>
