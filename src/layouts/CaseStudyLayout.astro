---
// Case-study pages reuse BaseLayout and add registry-derived breadcrumbs plus an
// Article graph keyed to Astro.site. buildEntityGraph emits page-level nodes only
// for public content (INV-03).
import BaseLayout from "./BaseLayout.astro";
import JsonLd from "../components/JsonLd.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { buildEntityGraph } from "../lib/structured-data.ts";
import type { Visibility } from "../lib/publishing.ts";

interface Props {
  routeId: string;
  title: string;
  description: string;
  visibility: Visibility;
  noindex?: boolean;
  // Dynamic-route params (e.g. { slug }) so the canonical + Article/BreadcrumbList
  // @id anchors resolve for a collection entry. Static routes (the hub) omit this.
  params?: Record<string, string>;
}

const { routeId, title, description, visibility, noindex, params } = Astro.props;

// Astro.site is the real origin from astro.config (SITE_ORIGIN ?? placeholder);
// buildEntityGraph normalises the trailing slash. Fall back to the placeholder
// so a mis-set config never throws at render time.
const site = Astro.site?.href ?? "https://example.com";
const graph = buildEntityGraph({
  site,
  page: { routeId, title, description, visibility, kind: "article", params },
});
---
<BaseLayout
  routeId={routeId}
  title={title}
  description={description}
  noindex={noindex ?? visibility === "noindex"}
  params={params}
  ogType="article"
>
  <JsonLd graph={graph} />
  <Breadcrumbs
    routeId={routeId}
    params={params}
    leafLabel={params === undefined ? undefined : title}
  />
  <slot />
</BaseLayout>
