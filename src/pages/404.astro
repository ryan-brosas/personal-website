---
// M2 (Plan 03, Child 2) — recoverable 404 page. Builds to /404.html (Astro
// special-cases status pages). Canonical is overridden to the slashless file
// endpoint /404.html (canonicalPath prop) because trailingSlash:"always" would
// otherwise produce /404/. noindex,follow keeps it crawlable but excluded from
// discovery. Recovery link lives inside main#main. The header nav marks no
// item current because /404.html is not a navigation page.
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Page not found — Ryan Brosas";
const description = "The page you were looking for could not be found.";
---
<BaseLayout title={title} description={description} canonicalPath="/404.html" noindex>
  <h1>Page not found</h1>
  <p>The page you were looking for could not be found.</p>
  <p><a href="/">Return to the home page</a></p>
</BaseLayout>
