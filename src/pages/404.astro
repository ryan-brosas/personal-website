---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Page not found | Ryan Brosas";
const description = "The page you were looking for could not be found.";
---
<BaseLayout routeId="404" title={title} description={description} noindex>
  <section class="page-shell">
    <header class="page-header">
      <p class="eyebrow">404 · Recovery path</p>
      <h1>Page not found</h1>
      <p class="page-lead">This route ended without a useful result. The home page is the safe fallback.</p>
    </header>
    <a class="button button--primary" href="/">Return to the home page</a>
  </section>
</BaseLayout>
