---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import JsonLd from "../../components/JsonLd.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageCta from "../../components/PageCta.astro";
import EntryHeader from "../../components/EntryHeader.astro";
import Byline from "../../components/Byline.astro";
import { ROUTE_REGISTRY } from "../../config/routes.ts";
import { isRoutable } from "../../lib/publishing.ts";
import { buildEntityGraph } from "../../lib/structured-data.ts";

export const getStaticPaths = (async () => {
  const entries = await getCollection("resources");
  return entries
    .filter((entry) => isRoutable(entry.data.visibility))
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const routeId = "resources-slug";
const params = { slug: entry.data.slug };
const site = Astro.site?.href ?? "https://example.com";
const graph = buildEntityGraph({
  site,
  page: {
    routeId,
    params,
    title: entry.data.title,
    description: entry.data.description,
    visibility: entry.data.visibility,
  },
});
---
<BaseLayout
  routeId={routeId}
  params={params}
  title={entry.data.title}
  description={entry.data.description}
  noindex={entry.data.visibility === "noindex"}
  ogType={entry.data.format === "article" ? "article" : "website"}
>
  <JsonLd graph={graph} />
  <Breadcrumbs routeId={routeId} params={params} leafLabel={entry.data.title} />

  <article class="case-study-shell">
    <EntryHeader
      eyebrow={`${entry.data.format} · ${entry.data.pillar.replaceAll("-", " ")}`}
      title={entry.data.title}
      description={entry.data.description}
    />
    <Byline />

    <div class="prose">
      <Content />
    </div>

    {
      entry.data.attachments && (
        <section class="prose" aria-labelledby="resource-downloads-title">
          <h2 id="resource-downloads-title">Downloads</h2>
          <ul>
            {entry.data.attachments.map((attachment) => (
              <li>
                <a
                  href={attachment.path}
                  type={attachment.mediaType}
                  download
                  data-resource-download
                >
                  {attachment.label}
                </a>
                {attachment.description && <p>{attachment.description}</p>}
                {attachment.license && <p class="case-meta">License: {attachment.license}</p>}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <PageCta
      id="resource-next-step"
      eyebrow="Ready to test one loop"
      title="Bring the checklist result."
      body="We can turn the gaps into a small, testable next step without forcing an AI build."
      primaryHref={ROUTE_REGISTRY.pathFor("contact")}
      primaryLabel="Start a conversation"
      secondaryHref={ROUTE_REGISTRY.pathFor("resources")}
      secondaryLabel="See all resources"
    />
  </article>
</BaseLayout>
