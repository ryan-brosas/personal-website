---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import JsonLd from "../../components/JsonLd.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isRoutable } from "../../lib/publishing.ts";
import { buildEntityGraph } from "../../lib/structured-data.ts";

export const getStaticPaths = (async () => {
  const entries = await getCollection("resources");
  return entries
    .filter((entry) => isRoutable(entry.data.visibility))
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const routeId = "resources-slug";
const params = { slug: entry.data.slug };
const site = Astro.site?.href ?? "https://example.com";
const graph = buildEntityGraph({
  site,
  page: {
    routeId,
    params,
    title: entry.data.title,
    description: entry.data.description,
    visibility: entry.data.visibility,
  },
});
---
<BaseLayout
  routeId={routeId}
  params={params}
  title={entry.data.title}
  description={entry.data.description}
  noindex={entry.data.visibility === "noindex"}
>
  <JsonLd graph={graph} />
  <Breadcrumbs routeId={routeId} params={params} />

  <article class="case-study-shell">
    <header class="case-study-header">
      <p class="eyebrow">{entry.data.format} · {entry.data.pillar.replaceAll("-", " ")}</p>
      <h1>{entry.data.title}</h1>
      <p class="case-study-lead">{entry.data.description}</p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>
