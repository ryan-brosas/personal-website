---
import { getCollection } from "astro:content";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import JsonLd from "../../components/JsonLd.astro";
import WorkflowRail from "../../components/WorkflowRail.astro";
import PageCta from "../../components/PageCta.astro";
import PageHeader from "../../components/PageHeader.astro";
import CollectionCard from "../../components/CollectionCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import { ROUTE_REGISTRY } from "../../config/routes.ts";
import { AI_DIRECTORY } from "../../data/ai-directory.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isDiscoverable } from "../../lib/publishing.ts";
import { buildEntityGraph } from "../../lib/structured-data.ts";

const routeId = "resources";
const title = "Resources";
const description =
  "Tools and short guides for AI workflows you can trust.";
const [resourceEntries, toolEntries, wikiCollection] = await Promise.all([
  getCollection("resources"),
  getCollection("tools"),
  getCollection("wiki"),
]);
const entries = [...resourceEntries, ...toolEntries]
  .filter((entry) => isDiscoverable(entry.data.visibility))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const wikiEntries = wikiCollection
  .filter((entry) => isDiscoverable(entry.data.visibility))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const wikiPreview = wikiEntries.slice(0, 6);
const resourceSections = [
  { format: "tool", title: "Tools & Demos", eyebrow: "Try the working system" },
  { format: "article", title: "Articles", eyebrow: "Ideas and field notes" },
  { format: "guide", title: "Guides", eyebrow: "Work through a system" },
  { format: "checklist", title: "Checklists", eyebrow: "Check a decision quickly" },
  { format: "template", title: "Templates", eyebrow: "Start from a reusable structure" },
  { format: "reference", title: "References", eyebrow: "Keep useful details close" },
] as const;
const resourceGroups = resourceSections
  .map((section) => ({
    ...section,
    entries: entries.filter((entry) => entry.data.format === section.format),
  }))
  .filter((section) => section.entries.length > 0);
const visibility = entries.length > 0 ? "public" : "noindex";
const contactHref = ROUTE_REGISTRY.pathFor("contact");
const checklistHref = ROUTE_REGISTRY.pathFor("resources-slug", { slug: "ai-workflow-readiness" });
const site = Astro.site?.href ?? "https://example.com";
const graph = buildEntityGraph({
  site,
  page: { routeId, title, description, visibility },
});
---
<BaseLayout
  routeId={routeId}
  title={title}
  description={description}
  noindex={visibility === "noindex"}
>
  <JsonLd graph={graph} />
  <Breadcrumbs routeId={routeId} />

  <section class="page-shell" aria-labelledby="resources-title">
    <PageHeader
      id="resources-title"
      eyebrow="Useful systems, made reusable"
      title={title}
      description={description}
    />

    <WorkflowRail
      label="Use the resource, then decide"
      steps={[
        { label: "Spot", detail: "Name the repeated work and its trigger." },
        { label: "Check", detail: "Test the context, review, and recovery path." },
        { label: "Choose", detail: "Keep it manual or build the smallest loop." },
      ]}
      caption="A useful check can tell you not to automate yet."
    />

    <section class="resource-group" aria-labelledby="resources-wiki">
      <SectionHeading
        id="resources-wiki"
        eyebrow="Plain-language reference"
        title="AI workflow wiki"
      >
        <p>Short definitions for AI workflow ideas. Each entry links back to its source.</p>
      </SectionHeading>
      <ul class="wiki-preview-list">
        {wikiPreview.map((entry) => (
          <li>
            <a href={ROUTE_REGISTRY.pathFor("wiki-slug", { slug: entry.data.slug })}>
              <strong>{entry.data.title}</strong>
              <span>{entry.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="wiki-preview-more">
        <a href={ROUTE_REGISTRY.pathFor("wiki")}>View all {wikiEntries.length} concepts</a>
      </p>
    </section>

    <section class="resource-group" aria-labelledby="resources-directory">
      <SectionHeading
        id="resources-directory"
        eyebrow="Official starting points"
        title="AI tools directory"
        titleHref={ROUTE_REGISTRY.pathFor("directory")}
      >
        <p>Model providers, local runtimes, agent frameworks, evaluation tools, and workflow automation links.</p>
      </SectionHeading>
      <nav class="directory-category-list" aria-label="AI tools directory categories">
        <ul>
          {AI_DIRECTORY.map((category) => (
            <li>
              <a href={ROUTE_REGISTRY.pathFor("directory") + "#directory-" + category.id}>
                <span>{category.title}</span>
                <small>{category.entries.length}</small>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>

    {
      entries.length === 0 ? (
        <p class="empty-state">The first resources are being prepared.</p>
      ) : (
        resourceGroups.map((group) => (
          <section class="resource-group" aria-labelledby={`resources-${group.format}`}>
            <SectionHeading
              id={`resources-${group.format}`}
              eyebrow={group.eyebrow}
              title={group.title}
            />
            <ul class="case-grid">
              {group.entries.map((entry) => (
                <li>
                  <CollectionCard
                    href={ROUTE_REGISTRY.pathFor(
                      entry.data.format === "tool" ? "tools-slug" : "resources-slug",
                      { slug: entry.data.slug },
                    )}
                    title={entry.data.title}
                    description={entry.data.description}
                    meta={`${entry.data.format} · ${entry.data.pillar.replaceAll("-", " ")}`}
                    headingLevel={3}
                    density="compact"
                  />
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }

    <PageCta
      id="resources-next-step"
      eyebrow="Found a loop worth fixing"
      title="Check one task on your own."
      body="Run the readiness checklist before you book a call. It shows what to fix first."
      primaryHref={checklistHref}
      primaryLabel="Use the checklist"
      secondaryHref={contactHref}
      secondaryLabel="Start a conversation"
    />
  </section>
</BaseLayout>
