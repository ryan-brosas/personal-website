---
import { getCollection } from "astro:content";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import JsonLd from "../../../components/JsonLd.astro";
import PageCta from "../../../components/PageCta.astro";
import PageHeader from "../../../components/PageHeader.astro";
import CollectionCard from "../../../components/CollectionCard.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import { ROUTE_REGISTRY } from "../../../config/routes.ts";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { isDiscoverable } from "../../../lib/publishing.ts";
import { buildEntityGraph } from "../../../lib/structured-data.ts";

const routeId = "wiki";
const title = "AI workflow wiki";
const description =
  "Short, plain definitions for AI workflow ideas. Each entry links back to its source.";

// Public (discoverable) wiki entries drive both the cards and the hub's own
// visibility: no public children => the hub is noindex,follow (mirrors the
// resources hub). The site-wide pillar is the sole grouping key.
const publicEntries = (await getCollection("wiki"))
  .filter((entry) => isDiscoverable(entry.data.visibility))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const PILLAR_LABELS = {
  "ai-workflow-systems": "AI workflow systems",
  "agent-reliability": "Agent reliability",
  "context-knowledge-systems": "Context knowledge systems",
  "content-research-operations": "Content & research",
} as const;

type PillarId = keyof typeof PILLAR_LABELS;

const grouped = (Object.keys(PILLAR_LABELS) as PillarId[])
  .map((pillar) => ({
    id: pillar,
    title: PILLAR_LABELS[pillar],
    entries: publicEntries.filter((entry) => entry.data.pillar === pillar),
  }))
  .filter((group) => group.entries.length > 0);

const visibility = publicEntries.length > 0 ? "public" : "noindex";
const contactHref = ROUTE_REGISTRY.pathFor("contact");
const checklistHref = ROUTE_REGISTRY.pathFor("resources-slug", { slug: "ai-workflow-readiness" });
const site = Astro.site?.href ?? "https://example.com";
const graph = buildEntityGraph({
  site,
  page: { routeId, title, description, visibility },
});
---
<BaseLayout
  routeId={routeId}
  title={title}
  description={description}
  noindex={visibility === "noindex"}
>
  <JsonLd graph={graph} />
  <Breadcrumbs routeId={routeId} />

  <section class="page-shell" aria-labelledby="wiki-title">
    <PageHeader
      id="wiki-title"
      title={title}
      description={description}
      titleMeasure="wide"
    />

    {
      publicEntries.length > 0 && (
        <form class="wiki-filter" data-wiki-filter role="search" hidden>
          <label for="wiki-concept-search">Find a concept</label>
          <div class="wiki-filter__field">
            <input
              id="wiki-concept-search"
              type="search"
              placeholder="What would you like to read about?"
              autocomplete="off"
            />
            <output for="wiki-concept-search" data-wiki-filter-count aria-live="polite">
              {publicEntries.length} concepts
            </output>
          </div>
        </form>
      )
    }

    {
      grouped.length === 0 ? (
        <p class="empty-state">The first wiki entries are being prepared.</p>
      ) : (
        grouped.map((group) => (
          <section class="resource-group" aria-labelledby={"wiki-" + group.id} data-wiki-group>
            <SectionHeading
              id={"wiki-" + group.id}
              title={group.title}
              layout="stacked"
            />
            <ul class="case-grid">
              {group.entries.map((entry) => (
                <li data-wiki-term data-wiki-search={`${entry.data.title} ${entry.data.description}`.toLowerCase()}>
                  <CollectionCard
                    href={ROUTE_REGISTRY.pathFor("wiki-slug", { slug: entry.data.slug })}
                    title={entry.data.title}
                    description={entry.data.description}
                    headingLevel={3}
                    density="compact"
                  />
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }

    <p class="wiki-filter-empty" data-wiki-filter-empty hidden>
      No concepts match that search yet.
    </p>

    <PageCta
      id="wiki-next-step"
      eyebrow="Found a term you keep hitting"
      title="Bring the word, not the worry."
      body="Bring one idea you keep running into. The checklist turns it into a small step you can test in your own workflow."
      primaryHref={checklistHref}
      primaryLabel="Use the checklist"
      secondaryHref={contactHref}
      secondaryLabel="Start a conversation"
    />
  </section>
</BaseLayout>
