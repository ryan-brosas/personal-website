---
import { getCollection } from "astro:content";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import JsonLd from "../../../components/JsonLd.astro";
import PageCta from "../../../components/PageCta.astro";
import { ROUTE_REGISTRY } from "../../../config/routes.ts";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { isDiscoverable, isRoutable } from "../../../lib/publishing.ts";
import { buildEntityGraph } from "../../../lib/structured-data.ts";

const routeId = "tools";
const title = "Tools & Demos";
const description = "Interactive tools and demos, including work that is still being prepared for a public launch.";
const entries = (await getCollection("tools"))
  .filter((entry) => isRoutable(entry.data.visibility))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const visibility = entries.some((entry) => isDiscoverable(entry.data.visibility)) ? "public" : "noindex";
const site = Astro.site?.href ?? "https://example.com";
const graph = buildEntityGraph({
  site,
  page: { routeId, title, description, visibility },
});
---
<BaseLayout routeId={routeId} title={title} description={description} noindex={visibility === "noindex"}>
  <JsonLd graph={graph} />
  <Breadcrumbs routeId={routeId} />

  <section class="page-shell" aria-labelledby="tools-title">
    <header class="page-header">
      <p class="eyebrow">Resources · Tools</p>
      <h1 id="tools-title">{title}</h1>
      <p class="page-lead">{description}</p>
    </header>

    {
      entries.length === 0 ? (
        <p class="empty-state">The first tools are being prepared.</p>
      ) : (
        <ul class="case-grid">
          {entries.map((entry) => (
            <li>
              <article class="case-card">
                <p class="case-meta">Tool · {entry.data.pillar.replaceAll("-", " ")}</p>
                <div>
                  <h2>
                    <a href={ROUTE_REGISTRY.pathFor("tools-slug", { slug: entry.data.slug })}>
                      {entry.data.title}
                    </a>
                  </h2>
                  <p>{entry.data.description}</p>
                </div>
              </article>
            </li>
          ))}
        </ul>
      )
    }

    <PageCta
      id="tools-next-step"
      eyebrow="More than a demo"
      title="See how the work is checked."
      body="Each public tool will link to the proof, limits, and build decisions behind it."
      primaryHref={ROUTE_REGISTRY.pathFor("resources")}
      primaryLabel="Browse all resources"
      secondaryHref={ROUTE_REGISTRY.pathFor("case-studies")}
      secondaryLabel="Read the case studies"
    />
  </section>
</BaseLayout>
