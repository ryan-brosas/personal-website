---
import { getCollection } from "astro:content";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import JsonLd from "../../../components/JsonLd.astro";
import PageCta from "../../../components/PageCta.astro";
import PageHeader from "../../../components/PageHeader.astro";
import CollectionCard from "../../../components/CollectionCard.astro";
import { ROUTE_REGISTRY } from "../../../config/routes.ts";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { isDiscoverable, isRoutable } from "../../../lib/publishing.ts";
import { buildEntityGraph } from "../../../lib/structured-data.ts";

const routeId = "tools";
const title = "Tools & Demos";
const description = "Live tools for inspecting AI telemetry and asking questions about Ryan’s work.";
const entries = (await getCollection("tools"))
  .filter((entry) => isRoutable(entry.data.visibility))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));
const visibility = entries.some((entry) => isDiscoverable(entry.data.visibility)) ? "public" : "noindex";
const site = Astro.site?.href ?? "https://example.com";
const graph = buildEntityGraph({
  site,
  page: { routeId, title, description, visibility },
});
---
<BaseLayout routeId={routeId} title={title} description={description} noindex={visibility === "noindex"}>
  <JsonLd graph={graph} />
  <Breadcrumbs routeId={routeId} />

  <section class="page-shell" aria-labelledby="tools-title">
    <PageHeader
      id="tools-title"
      eyebrow="Resources · Tools"
      title={title}
      description={description}
    />

    {
      entries.length === 0 ? (
        <p class="empty-state">No live tools are listed yet.</p>
      ) : (
        <ul class="case-grid">
          {entries.map((entry) => (
            <li>
              <CollectionCard
                href={ROUTE_REGISTRY.pathFor("tools-slug", { slug: entry.data.slug })}
                title={entry.data.title}
                description={entry.data.description}
                meta={`Tool · ${entry.data.pillar.replaceAll("-", " ")}`}
                headingLevel={2}
                density="compact"
              />
            </li>
          ))}
        </ul>
      )
    }

    <PageCta
      id="tools-next-step"
      eyebrow="Before you pick a tool"
      title="Check if the work is ready to automate."
      body="Run the readiness checklist first. It names the trigger, context, checks, and handoff a tool needs."
      primaryHref={ROUTE_REGISTRY.pathFor("resources-slug", { slug: "ai-workflow-readiness" })}
      primaryLabel="Use the checklist"
      secondaryHref={ROUTE_REGISTRY.pathFor("resources")}
      secondaryLabel="Browse all resources"
    />
  </section>
</BaseLayout>
