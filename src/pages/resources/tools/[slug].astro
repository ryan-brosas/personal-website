---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import JsonLd from "../../../components/JsonLd.astro";
import PageCta from "../../../components/PageCta.astro";
import EntryHeader from "../../../components/EntryHeader.astro";
import Byline from "../../../components/Byline.astro";
import { ROUTE_REGISTRY } from "../../../config/routes.ts";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { isRoutable } from "../../../lib/publishing.ts";
import { buildEntityGraph } from "../../../lib/structured-data.ts";

export const getStaticPaths = (async () => {
  const entries = await getCollection("tools");
  return entries
    .filter((entry) => isRoutable(entry.data.visibility))
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const routeId = "tools-slug";
const params = { slug: entry.data.slug };
const site = Astro.site?.href ?? "https://example.com";
const graph = buildEntityGraph({
  site,
  page: {
    routeId,
    params,
    title: entry.data.title,
    description: entry.data.description,
    visibility: entry.data.visibility,
  },
});
---
<BaseLayout
  routeId={routeId}
  params={params}
  title={entry.data.title}
  description={entry.data.description}
  noindex={entry.data.visibility === "noindex"}
>
  <JsonLd graph={graph} />
  <Breadcrumbs routeId={routeId} params={params} leafLabel={entry.data.title} />

  <article class="case-study-shell">
    <EntryHeader
      eyebrow={`Tool · ${entry.data.pillar.replaceAll("-", " ")}`}
      title={entry.data.title}
      description={entry.data.description}
    />
    <Byline />

    <div class="prose">
      <Content />
    </div>

    <PageCta
      id="tool-next-step"
      eyebrow="Still in development"
      title="This tool is not ready to launch yet."
      body="The public demo, its limits, and its proof will be added when they can be checked."
      primaryHref={ROUTE_REGISTRY.pathFor("tools")}
      primaryLabel="See all tools"
      secondaryHref={ROUTE_REGISTRY.pathFor("resources")}
      secondaryLabel="Browse resources"
    />
  </article>
</BaseLayout>
