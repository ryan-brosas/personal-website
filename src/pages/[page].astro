---
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render } from "astro:content";
import CommercialLayout from "../layouts/CommercialLayout.astro";
import WorkflowRail from "../components/WorkflowRail.astro";
import PageCta from "../components/PageCta.astro";
import CommercialHero from "../components/CommercialHero.astro";
import type { CommercialPageId } from "../components/CommercialHero.astro";
import { ROUTE_REGISTRY } from "../config/routes.ts";
import { isRoutable } from "../lib/publishing.ts";
import { assertMarkdownRendered } from "../lib/markdown-safety.ts";
import type { EntityGraphPageKind } from "../lib/structured-data.ts";

export const getStaticPaths = (async () => {
  const entries = await getCollection("pages");
  for (const entry of entries) {
    assertMarkdownRendered(entry);
  }
  const entriesById = new Map(entries.map((entry) => [entry.id, entry]));

  return ROUTE_REGISTRY.all()
    .filter((definition) => definition.kind === "singleton" && definition.navPlacement === "primary")
    .flatMap((definition) => {
      const entry = entriesById.get(definition.id);
      if (!entry || !isRoutable(entry.data.visibility)) return [];
      const match = definition.path.match(/^\/([^/?#]+)\/$/);
      if (!match) {
        throw new Error(`Route ${definition.path} for "${definition.id}" is not a single-segment HTML path`);
      }
      return [{ params: { page: match[1] }, props: { entry } }];
    });
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const pageId = entry.id as CommercialPageId;
const kind: EntityGraphPageKind = pageId === "services" ? "service" : "webpage";
const contact =
  pageId === "contact" ? (await getEntry("settings", "site"))?.data.contact : undefined;
if (pageId === "contact" && !contact) {
  throw new Error("contact entry requires a validated settings.data.contact block");
}

const eyebrows: Record<CommercialPageId, string> = {
  about: "The operator behind the systems",
  services: "One task · One clear loop",
  contact: "Start with the recurring work",
};

const contactHref = ROUTE_REGISTRY.pathFor("contact");
const caseStudiesHref = ROUTE_REGISTRY.pathFor("case-studies");
const servicesHref = ROUTE_REGISTRY.pathFor("services");
const serviceRail = {
  label: "How one task moves",
  steps: [
    { label: "Trace", detail: "See how the task runs now." },
    { label: "Build", detail: "Make the smallest useful system." },
    { label: "Prove", detail: "Test it on real work." },
    { label: "Hand off", detail: "Leave a path your team can run." },
  ],
  caption: "The task picks the tool.",
};

const pageCta = {
  services: {
    eyebrow: "Start with one task",
    title: "Which task keeps pulling you back in?",
    body: "Bring the task, how it works now, and where it gets stuck.",
    primaryHref: contactHref,
    primaryLabel: "Start with one task",
    secondaryHref: caseStudiesHref,
    secondaryLabel: "See a real build",
  },
  about: {
    eyebrow: "See the approach in practice",
    title: "Start with the work, not the AI.",
    body: "See how the method works, then bring one loop when you are ready.",
    primaryHref: servicesHref,
    primaryLabel: "See how I work",
    secondaryHref: caseStudiesHref,
    secondaryLabel: "Read the case study",
  },
  contact: {
    eyebrow: "No tidy brief needed",
    title: "Bring the rough version.",
    body: "We will decide if the next step is an agent, a script, a process change, or nothing at all.",
    primaryHref: contact?.schedulerUrl ?? contactHref,
    primaryLabel: "Schedule a conversation",
    primaryRel: "noopener noreferrer",
    secondaryHref: contact ? `mailto:${contact.emailFallback}` : undefined,
    secondaryLabel: contact?.emailFallback,
  },
}[entry.id as "services" | "about" | "contact"];
---
<CommercialLayout
  routeId={entry.id}
  title={entry.data.title}
  description={entry.data.description}
  visibility={entry.data.visibility}
  noindex={entry.data.visibility === "noindex"}
  kind={kind}
>
  <article class={`page-shell page-shell--${entry.id}`}>
    <CommercialHero
      pageId={pageId}
      eyebrow={eyebrows[pageId]}
      title={entry.data.title}
      description={entry.data.description}
    />

    {
      entry.id === "services" && (
        <WorkflowRail
          label={serviceRail.label}
          steps={serviceRail.steps}
          caption={serviceRail.caption}
        />
      )
    }

    <div class="prose">
      <Content />
    </div>

    <PageCta
      id={`${entry.id}-next-step`}
      eyebrow={pageCta.eyebrow}
      title={pageCta.title}
      body={pageCta.body}
      primaryHref={pageCta.primaryHref}
      primaryLabel={pageCta.primaryLabel}
      primaryRel={pageCta.primaryRel}
      secondaryHref={pageCta.secondaryHref}
      secondaryLabel={pageCta.secondaryLabel}
    />
  </article>
</CommercialLayout>
