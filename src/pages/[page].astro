---
import type { GetStaticPaths } from "astro";
import { getCollection, getEntry, render } from "astro:content";
import CommercialLayout from "../layouts/CommercialLayout.astro";
import HeroOperator from "../assets/brand/operator-mascot.svg";
import HeroSystemMap from "../assets/brand/hero-system-conductor.svg";
import { ROUTE_REGISTRY } from "../config/routes.ts";
import { isRoutable } from "../lib/publishing.ts";
import { assertMarkdownRendered } from "../lib/markdown-safety.ts";
import type { EntityGraphPageKind } from "../lib/structured-data.ts";

export const getStaticPaths = (async () => {
  const entries = await getCollection("pages");
  for (const entry of entries) {
    assertMarkdownRendered(entry);
  }
  const entriesById = new Map(entries.map((entry) => [entry.id, entry]));

  return ROUTE_REGISTRY.all()
    .filter((definition) => definition.kind === "singleton" && definition.navPlacement === "primary")
    .flatMap((definition) => {
      const entry = entriesById.get(definition.id);
      if (!entry || !isRoutable(entry.data.visibility)) return [];
      const match = definition.path.match(/^\/([^/?#]+)\/$/);
      if (!match) {
        throw new Error(`Route ${definition.path} for "${definition.id}" is not a single-segment HTML path`);
      }
      return [{ params: { page: match[1] }, props: { entry } }];
    });
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const kind: EntityGraphPageKind = entry.id === "services" ? "service" : "webpage";
const contact =
  entry.id === "contact" ? (await getEntry("settings", "site"))?.data.contact : undefined;
if (entry.id === "contact" && !contact) {
  throw new Error("contact entry requires a validated settings.data.contact block");
}

const eyebrows: Record<string, string> = {
  about: "The operator behind the systems",
  services: "Design · Build · Handoff",
  contact: "Start with the recurring work",
};
---
<CommercialLayout
  routeId={entry.id}
  title={entry.data.title}
  description={entry.data.description}
  visibility={entry.data.visibility}
  noindex={entry.data.visibility === "noindex"}
  kind={kind}
>
  <article class={`page-shell page-shell--${entry.id}`}>
    <header class="page-header commercial-hero">
      <div class="page-header__copy">
        <p class="eyebrow">{eyebrows[entry.id] ?? "Ryan Brosas"}</p>
        <h1>{entry.data.title}</h1>
        <p class="page-lead">{entry.data.description}</p>
      </div>

      {
        entry.id === "about" && (
          <aside class="page-visual page-visual--about" aria-label="Operator profile">
            <HeroOperator aria-hidden="true" focusable="false" />
            <dl>
              <div><dt>Based</dt><dd>Philippines</dd></div>
              <div><dt>Mode</dt><dd>Remote</dd></div>
              <div><dt>Focus</dt><dd>Recurring operations</dd></div>
            </dl>
          </aside>
        )
      }

      {
        entry.id === "services" && (
          <aside class="page-visual page-visual--services" aria-label="System design options">
            <HeroSystemMap aria-hidden="true" focusable="false" />
            <ul class="system-form-list" aria-label="Possible system forms">
              <li>Agent</li>
              <li>Script</li>
              <li>Process</li>
            </ul>
          </aside>
        )
      }

      {
        entry.id === "contact" && (
          <aside class="page-visual page-visual--contact" aria-label="What to bring to the first conversation">
            <p>Bring one stubborn loop</p>
            <ol class="intake-sequence">
              <li><span>01</span><strong>Recurring work</strong></li>
              <li><span>02</span><strong>Current workaround</strong></li>
              <li><span>03</span><strong>Breaking point</strong></li>
            </ol>
          </aside>
        )
      }
    </header>

    <div class="commercial-body">
      <div class="prose">
        <Content />
      </div>

      {
        contact && (
          <div class="contact-actions">
            <a class="button button--primary" href={contact.schedulerUrl} rel="noopener noreferrer">
              Schedule a conversation
            </a>
            <a class="button button--secondary" href={`mailto:${contact.emailFallback}`}>
              {contact.emailFallback}
            </a>
          </div>
        )
      }
    </div>
  </article>
</CommercialLayout>
