---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import CaseStudyLayout from "../../layouts/CaseStudyLayout.astro";
import EvidenceNote from "../../components/EvidenceNote.astro";
import { isRoutable } from "../../lib/publishing.ts";
import { resolvePublicClaim } from "../../lib/evidence.ts";
import type { ClaimRecord, SourceRegistry } from "../../lib/evidence.ts";
import sourcesJson from "../../data/sources.json" with { type: "json" };

export const getStaticPaths = (async () => {
  const entries = await getCollection("case-studies");
  return entries
    .filter((entry) => isRoutable(entry.data.visibility))
    .map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const registry = sourcesJson as unknown as SourceRegistry;
const evidence = entry.data.evidence;
const claim: ClaimRecord | undefined =
  evidence?.kind === "verified"
    ? {
        id: `case-study-${entry.data.slug}-evidence`,
        statement: entry.data.description,
        kind: "fact",
        sourceIds: [evidence.sourceId],
        status: "approved",
      }
    : undefined;

// Fail-closed: a PUBLIC case study must ship with resolvable public-safe evidence.
// A verified claim whose sourceId is absent from the registry, or backed only by an
// internal-only source, fails the build rather than silently rendering no evidence.
if (entry.data.visibility === "public") {
  if (!claim || !resolvePublicClaim(claim, registry).ok) {
    throw new Error(
      `public case study "${entry.data.slug}" does not resolve to a public-safe evidence source`,
    );
  }
}
---
<CaseStudyLayout
  routeId="case-studies-slug"
  title={entry.data.title}
  description={entry.data.description}
  visibility={entry.data.visibility}
  params={{ slug: entry.data.slug }}
>
  <article class="case-study-shell">
    <header class="case-study-header">
      <p class="eyebrow">Case study · {entry.data.pillar.replaceAll("-", " ")}</p>
      <h1>{entry.data.title}</h1>
      <p class="case-study-lead">{entry.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {claim && <EvidenceNote claim={claim} registry={registry} />}
  </article>
</CaseStudyLayout>
