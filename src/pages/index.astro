---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrandSystemLab from "../components/brand/BrandSystemLab.astro";
import JsonLd from "../components/JsonLd.astro";
import HomeHero from "../components/HomeHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import PageCta from "../components/PageCta.astro";
import ProofStrip from "../components/ProofStrip.astro";
import SignalList from "../components/SignalList.astro";
import ProcessDiagram from "../components/ProcessDiagram.astro";
import EntryPoints from "../components/EntryPoints.astro";
import CaseFeature from "../components/CaseFeature.astro";
import OutcomeColumns from "../components/OutcomeColumns.astro";
import VerifiedClaims from "../components/VerifiedClaims.astro";
import { buildEntityGraph } from "../lib/structured-data.ts";
import { homepageVerifiedClaims } from "../lib/home-proof.ts";
import { selectPublicProofPoints } from "../lib/proof-points.ts";
import { getCollection } from "astro:content";
import sourcesJson from "../data/sources.json" with { type: "json" };
import { parseSourceRegistryOrThrow } from "../config/entities.ts";
import { ROUTE_REGISTRY } from "../config/routes.ts";

const routeId = "home";
const showBrandLab = import.meta.env.DEV && import.meta.env.PUBLIC_BRAND_LAB === "true";
const title = showBrandLab ? "Ryan Brosas | Brand Lab" : "Ryan Brosas | Clear systems for work that keeps coming back";
const description = showBrandLab
  ? "Local working reference for the Ryan Brosas brand system and website components."
  : "I turn one repeated task into a clear system your team can run, check, and fix.";

const home = ROUTE_REGISTRY.byId("home");
const visibility = home?.visibility ?? "noindex";
const servicesHref = ROUTE_REGISTRY.pathFor("services");
const contactHref = ROUTE_REGISTRY.pathFor("contact");
const caseStudiesHref = ROUTE_REGISTRY.pathFor("case-studies");
const caseStudyHref = ROUTE_REGISTRY.pathFor("case-studies-slug", { slug: "this-site" });
const resourcesHref = ROUTE_REGISTRY.pathFor("resources");
const aboutHref = ROUTE_REGISTRY.pathFor("about");
const claims = homepageVerifiedClaims();
const frictionSignals = [
  { title: "The task starts from scratch", detail: "Someone gathers the same facts again." },
  { title: "The easy path works", detail: "Then one odd case needs you to clean it up." },
  { title: "The team does not trust the handoff", detail: "No clear check shows what ran or what needs help." },
];
const processStages = [
  { label: "Trace", detail: "Find the start, the facts, the choices, the checks, and the breaks." },
  { label: "Design", detail: "Make the smallest system that can do the job and ask for help." },
  { label: "Prove", detail: "Run it on real work. Check the result. Fix the gaps.", proven: true },
];
const entryPoints = [
  { href: servicesHref, title: "How I work", detail: "See how one task becomes a clear loop." },
  { href: caseStudiesHref, title: "Case studies", detail: "See what was built and why." },
  { href: resourcesHref, title: "Resources", detail: "Run a simple check on your own work." },
  { href: aboutHref, title: "About", detail: "Learn what guides the work." },
];

// Evidence rail. Entries are content (src/content/proof/*.md) but only reach the
// page through the shared evidence kernel, so an unbacked figure never renders.
const sourceRegistry = parseSourceRegistryOrThrow(sourcesJson);
const proofPoints = selectPublicProofPoints(
  (await getCollection("proof")).map((entry) => ({ id: entry.id, ...entry.data })),
  sourceRegistry,
);

const site = Astro.site?.href ?? "https://example.com";
const graph = buildEntityGraph({ site, page: { routeId, title, description, visibility } });
---
<BaseLayout routeId={routeId} title={title} description={description}>
  <JsonLd graph={graph} />

  {
    showBrandLab && BrandSystemLab ? (
      <BrandSystemLab />
    ) : (
      <>
  <HomeHero primaryHref={contactHref} secondaryHref={caseStudyHref} />

  {
    proofPoints.length > 0 && (
      <section class="home-section">
        <ProofStrip items={proofPoints} />
      </section>
    )
  }

  <section class="home-section" aria-labelledby="friction-title">
    <SectionHeading
      id="friction-title"
      eyebrow="The problem"
      title="The work runs only while you watch it."
    >
      <p>
        Facts hide in chats and files. Odd cases come back to you. No clear check shows if the
        work is safe to use.
      </p>
    </SectionHeading>

    <SignalList items={frictionSignals} />

    <div class="button-row section-actions">
      <a class="button button--secondary" href={resourcesHref}>Check one task</a>
    </div>
  </section>

  <section class="home-section" aria-labelledby="method-title">
    <SectionHeading
      id="method-title"
      eyebrow="The fix"
      title="Turn one stuck task into a clear loop."
    >
      <p>
        The answer may be an agent, a script, or a new step. We choose after we map the work.
      </p>
    </SectionHeading>

    <ProcessDiagram
      stages={processStages}
      caption="The loop must run on real work before it can earn more scope."
    />

    <div class="button-row section-actions">
      <a class="button button--secondary" href={servicesHref}>See how I work</a>
    </div>
  </section>

  <section class="home-section" aria-labelledby="case-title">
    <CaseFeature
      id="case-title"
      eyebrow="Proof you can inspect"
      title="This site shows how the rules work."
      body="This site uses one route list, clear rules for what goes live, proof checks, and build tests that must pass."
      primaryHref={caseStudyHref}
      primaryLabel="Read the case study"
      secondaryHref={caseStudiesHref}
      secondaryLabel="All case studies"
      items={[
        { label: "Content", status: "validated" },
        { label: "Route registry", status: "canonical" },
        { label: "Evidence policy", status: "fail-closed" },
        { label: "Static build", status: "verified" },
      ]}
    />

    {
      claims.length > 0 && (
        <VerifiedClaims claims={claims} />
      )
    }
  </section>

  <section class="home-section" aria-labelledby="fit-title">
    <SectionHeading
      id="fit-title"
      eyebrow="What changes"
      title="Your team gets a system it can use."
    >
      <p>
        One task no longer rests on one person. Your team can run it, check it, and fix it.
      </p>
    </SectionHeading>

    <OutcomeColumns
      columns={[
        {
          title: "What you get",
          items: [
            { title: "A clear map", detail: "The path from start to finish, with each check and odd case." },
            { title: "A small working system", detail: "An agent, a script, a review step, or a mix that fits the task." },
            { title: "A safe handoff", detail: "Clear checks, a safe stop, and notes your team can use." },
          ],
        },
        {
          title: "Who it’s for",
          items: [
            { title: "The same task eats your attention every week." },
            { title: "Key facts are scattered, so someone rebuilds them each time." },
            { title: "Your automation handles the easy path but leaves you cleaning up." },
            { title: "You want one real workflow fixed before you commit to more." },
          ],
        },
      ]}
    />

    <div class="button-row section-actions">
      <a class="button button--secondary" href={servicesHref}>See the full engagement</a>
    </div>
  </section>

  <section class="home-section" aria-labelledby="entry-title">
    <SectionHeading
      id="entry-title"
      eyebrow="Choose a next step"
      title="Start where you are."
    >
      <p>
        You do not need to talk yet. See the method, read the proof, or run a check on your own
        work.
      </p>
    </SectionHeading>

    <EntryPoints items={entryPoints} />
  </section>

  <PageCta
    class="home-section"
    id="contact-title"
    eyebrow="Start with one stubborn loop"
    title="Which task keeps coming back?"
    body="Bring one task, how it works now, and where it gets stuck."
    primaryHref={contactHref}
    primaryLabel="Start with one task"
  />
      </>
    )
  }
</BaseLayout>
